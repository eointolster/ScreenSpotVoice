GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8766
ALLOWED_EXTENSION_ID=
GEMINI_IMAGE_FPS=0.8

# Model provider: "gemini" (default, live duplex voice) or "local".
# "local" uses a vision+tools model on your own machine via Ollama. Chrome
# transcribes the microphone, so no audio reaches this backend; screenshots are
# never sent to Google on this path. The Gemini key is not required and ignored.
MODEL_BACKEND=gemini
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
